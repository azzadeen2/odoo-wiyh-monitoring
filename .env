
COMPOSE_PROJECT_NAME=odoo-sales
# COMPOSE_PROFILES=redis-insight


ODOO_IMAGE=odoo17-ssys:latest

NGINX_PORT=8077
PGADMIN_PORT=5051
# ===========================================
# Database Configuration
# ===========================================
# postgres db 
# POSTGRES_IMAGE=postgres:15 
# or for using GIS
# POSTGRES_IMAGE=postgis/postgis:15-3.5

POSTGRES_USER=odoo
POSTGRES_PASSWORD=myodoo
POSTGRES_DB=postgres

# ===========================================
# Odoo Database Configuration (for pgbouncer)
# ===========================================
ODOO_DB_NAME=odoo17db
ODOO_USER=odoo
ODOO_PASSWORD=myodoo

# ===========================================
# PgAdmin Configuration
# ===========================================
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin@2026

# ===========================================
# Redis Session Configuration
# ===========================================
# Enable Redis sessions (1 or true to enable)
ODOO_SESSION_REDIS=1

# Redis connection settings
ODOO_SESSION_REDIS_HOST=redis
ODOO_SESSION_REDIS_PORT=6379

# Redis password (optional - uncomment if Redis requires authentication)
# ODOO_SESSION_REDIS_PASSWORD=your_redis_password

# Session prefix for Redis keys (optional)
ODOO_SESSION_REDIS_PREFIX=odoo17

# Session expiration in seconds (default: 604800 = 7 days)
ODOO_SESSION_REDIS_EXPIRATION=31104000

# Anonymous session expiration in seconds (default: 10800 = 3 hours)
ODOO_SESSION_REDIS_EXPIRATION_ANONYMOUS=10800

# ===========================================
# Monitoring Configuration
# ===========================================
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin@2026
PROMETHEUS_PORT=9091
LOKI_PORT=3100
